{% comment %}
  コレクションのカテゴリ一覧（犬/猫を自動判定）。
  もともと sections/c_collectionCategory.liquid に直書きされていたロジックを
  スニペット化したもの。2箇所から同じ一覧を出すために切り出した。

    variant: 'chips'   … 上部の横並び（SP用）  ※既存の見た目
             'sidebar' … 左サイドバー（PC用）

  ⚠️ 元コードでは猫ページの「全ての商品」が /collections/dog-all を指していた（犬に飛ぶ不具合）。
     切り出しの際に cat-all へ修正した（2026-08-01）。

  受け取り: variant
{% endcomment %}

{%- liquid
  assign variant = variant | default: 'chips'
  if collection.handle contains 'cat'
    assign pet = 'cat'
  else
    assign pet = 'dog'
  endif
  assign sorted_collections = collections | sort: 'title' | reverse
  assign all_handle = pet | append: '-all'
-%}

<ul class="c_colNav c_colNav--{{ variant }}{% if variant == 'chips' %} c_collectionCategory__wrap page-width{% endif %}">
  <li class="c_colNav__item{% if variant == 'chips' %} c_collectionCategory__item{% endif %}{% if collection.handle == all_handle %} is-current{% endif %}">
    <a href="/collections/{{ all_handle }}"{% if collection.handle == all_handle %} aria-current="page"{% endif %}>
      <span>全ての商品</span>
    </a>
  </li>

  {%- for col in sorted_collections -%}
    {%- if col.handle contains pet -%}
      {%- unless col.handle contains 'all'
        or col.handle contains 'make'
        or col.handle contains 'trial'
        or col.handle contains 'osechi'
        or col.handle contains 'soba'
      -%}
        <li class="c_colNav__item{% if variant == 'chips' %} c_collectionCategory__item{% endif %}{% if col.handle == collection.handle %} is-current{% endif %}">
          <a href="/collections/{{ col.handle }}"{% if col.handle == collection.handle %} aria-current="page"{% endif %}>
            <span>{{ col.title | split: '-' | last }}</span>
          </a>
        </li>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} 手作りごはん（-make）は上のループから除外しているので最後に置く {%- endcomment -%}
  {%- for col in sorted_collections -%}
    {%- if col.handle contains pet and col.handle contains 'make' -%}
      <li class="c_colNav__item{% if variant == 'chips' %} c_collectionCategory__item{% endif %}{% if col.handle == collection.handle %} is-current{% endif %}">
        <a href="/collections/{{ col.handle }}"{% if col.handle == collection.handle %} aria-current="page"{% endif %}>
          <span>{{ col.title | split: '-' | last }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}

  <li class="c_colNav__item{% if variant == 'chips' %} c_collectionCategory__item{% endif %}">
    <a href="/products/{{ pet }}-trial-set">
      <span>お試しセット</span>
    </a>
  </li>
</ul>
