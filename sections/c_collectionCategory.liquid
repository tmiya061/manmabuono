{{ 'c_common.min.css' | asset_url | stylesheet_tag }}
{{ 'c_collectionCat.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 750px) {
      #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_sp }}px;
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
      }
  }
{%- endstyle -%}

{%- comment -%} 一覧の中身は snippets/c_collection-nav.liquid に集約（サイドバーと共用） {%- endcomment -%}
{% render 'c_collection-nav', variant: 'chips' %}

<div class="c_collectionCategory__title-wrap page-width">
  {%- comment -%}
    ページ固有の語を持つのはここだけなので、コレクションページのh1はこれ。
    主要10コレクションは 2026-09-02 に「犬用のドライフード」型へ改名済みで '-' を含まないため、
    そのままの名前が出る（西川さん指定の文言）。'-' 付きで残る少数（お試し・おせち・そば・お食事代行）
    だけ従来どおり後半を出す。
  {%- endcomment -%}
  <h1 class="c_collectionCategory__title">{{ collection.title | split: '-' | last | strip }}</h1>
  <svg
    class="c_collectionCategory__icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 18 18"
    fill="none"
  >
    <path d="M16 2L2 16" stroke="#FF7B5E" stroke-width="3"/>
  </svg>
</div>

{% schema %}
{
  "name": "コレクションカテゴリ",
  "settings": [
    {
      "type": "header",
      "content": "上下の余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "上部の余白（pc）",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "下部の余白（PC)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_sp",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上部の余白",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下部の余白",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "コレクションカテゴリ",
      "category": "カスタムパーツ"
    }
  ]
}
{% endschema %}
