{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_sp }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* 見出し（コレクション小カテゴリの c_catGroup__title と同じ見た目） */
  #shopify-section-{{ section.id }} .c_prodRecommend__title {
    margin: 0 0 25px;
    color: #ff7b5e;
    font-size: 24px;
    font-weight: 700;
    line-height: 140%;
  }

  #shopify-section-{{ section.id }} .c_prodRecommend__desc {
    text-align: left;
    color: #3c3c3c;
    margin: -10px 0 18px;
    max-width: 100%;
    font-size: 14px;
    line-height: 180%;
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} .c_prodRecommend__title {
      font-size: 20px;
      margin-bottom: 15px;
    }
  }

  /* ランダム表示用：多めに描画した候補のうち先頭 limit 件だけ見せる */
  #c_prodRecommend-grid-{{ section.id }} > li:nth-child(n + {{ section.settings.product_limit | plus: 1 }}) {
    display: none;
  }
{%- endstyle -%}

{%- liquid
  # 商品の所属コレクションからカテゴリ（役割）と犬猫を判定する
  assign handles = product.collections | map: 'handle' | join: ','

  assign pet = 'cat'
  if handles contains 'dog-'
    assign pet = 'dog'
  endif

  assign role = 'other'
  if handles contains '-dry'
    assign role = 'dry'
  elsif handles contains '-wet'
    assign role = 'wet'
  elsif handles contains 'easy-cook'
    assign role = 'snack'
  endif

  case role
    when 'dry'
      assign source_handle = pet | append: '-wet'
      assign heading = section.settings.heading_dry
      assign desc = section.settings.desc_dry
      assign randomize = true
    when 'wet'
      assign source_handle = pet | append: '-dry'
      assign heading = section.settings.heading_wet
      assign desc = section.settings.desc_wet
      assign randomize = false
    else
      assign source_handle = pet | append: '-all'
      assign heading = section.settings.heading_other
      assign desc = ''
      assign randomize = true
  endcase

  assign source = collections[source_handle]
  assign limit = section.settings.product_limit

  # ランダム表示の仕組み：Liquidに乱数が無いため、候補を多めに描画して
  # JSでシャッフル→CSS(nth-child)で先頭 limit 件だけ表示する。
  # 画像は loading=lazy なので非表示分のダウンロードは発生しない。
  assign render_cap = limit
  if randomize
    assign render_cap = 20
  endif
-%}

{%- if source.products.size > 0 -%}
  <div class="section-{{ section.id }}-padding gradient color-background-1">
    <div class="collection page-width">
      {%- if heading != blank -%}
        <h2 class="c_prodRecommend__title">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if desc != blank -%}
        <p class="c_prodRecommend__desc">{{ desc | escape }}</p>
      {%- endif -%}

      <ul
        id="c_prodRecommend-grid-{{ section.id }}"
        class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
        role="list"
      >
        {%- assign shown = 0 -%}
        {%- for item in source.products -%}
          {%- if item.handle == product.handle -%}
            {%- continue -%}
          {%- endif -%}
          {%- if item.handle contains '追加用' -%}
            {%- continue -%}
          {%- endif -%}
          {%- capture c_size_hidden -%}{%- render 'c_size-links', target_product: item, mode: 'hidden' -%}{%- endcapture -%}
          {%- if c_size_hidden contains 'hide' -%}{%- continue -%}{%- endif -%}
          {%- if shown >= render_cap -%}
            {%- break -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="grid__item">
            {% render 'card-product',
              card_product: item,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              show_secondary_image: false,
              show_vendor: false,
              show_rating: false,
              lazy_load: true,
              show_quick_add: section.settings.enable_quick_add,
              section_id: section.id,
              trim_size_title: true
            %}
          </li>
        {%- endfor -%}
      </ul>
      {%- if randomize -%}
        <script>
          (function () {
            var ul = document.getElementById('c_prodRecommend-grid-{{ section.id }}');
            if (!ul || ul.children.length < 2) return;
            var lis = Array.prototype.slice.call(ul.children);
            for (var i = lis.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var t = lis[i]; lis[i] = lis[j]; lis[j] = t;
            }
            for (var k = 0; k < lis.length; k++) ul.appendChild(lis[k]);
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "商品おすすめ（ごはんとおかず）",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "商品のカテゴリに応じて提案先が変わります：主食→おかず／おかず→ごはん／その他→おすすめ商品コレクション。"
    },
    {
      "type": "text",
      "id": "heading_dry",
      "label": "見出し（主食のページ）",
      "default": "このごはんに合うおかず"
    },
    {
      "type": "text",
      "id": "desc_dry",
      "label": "説明（主食のページ・任意）",
      "default": "マンマボーノは「ごはんとおかず」スタイル。ウェットのおかずをのせて、食事から水分を摂れる献立に。"
    },
    {
      "type": "text",
      "id": "heading_wet",
      "label": "見出し（おかず・スープのページ）",
      "default": "このおかずに合わせる毎日のごはん"
    },
    {
      "type": "text",
      "id": "desc_wet",
      "label": "説明（おかず・スープのページ・任意）",
      "default": "おかずは栄養補完食。総合栄養食のごはんと一緒にどうぞ。"
    },
    {
      "type": "text",
      "id": "heading_other",
      "label": "見出し（おやつ・その他のページ）",
      "default": "一緒によく選ばれています"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "表示する商品数",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "PC列数",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "SP列数",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "画像比率",
      "options": [
        { "value": "adapt", "label": "画像に合わせる" },
        { "value": "portrait", "label": "縦長" },
        { "value": "square", "label": "正方形" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "画像の形",
      "options": [
        { "value": "default", "label": "デフォルト" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "クイック追加ボタンを表示",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上余白（PC）",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下余白（PC）",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下余白（SP）",
      "default": 24
    }
  ]
}
{% endschema %}
