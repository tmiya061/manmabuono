{{ 'c_common.min.css' | asset_url | stylesheet_tag }}
{{ 'c_article.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_sp }}px;
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # ---- カテゴリ判定：article_category メタオブジェクトのハンドルと一致するタグ＝カテゴリ ----
  assign category = blank
  assign category_tag = blank
  for tag in article.tags
    assign mo = shop.metaobjects.article_category[tag]
    if mo
      assign category = mo
      assign category_tag = tag
      break
    endif
  endfor

  # ---- 著者・監修者（メタフィールド custom.author / custom.supervisor）----
  assign author_mo = article.metafields.custom.author.value
  assign supervisor_mo = article.metafields.custom.supervisor.value
  assign author_name = author_mo.name.value | default: section.settings.default_author

  # ---- 商品CTA：記事ごとの指定（custom.related_collection）→ なければセクション設定 ----
  assign cta_collection = article.metafields.custom.related_collection.value
  unless cta_collection
    assign cta_collection = section.settings.fallback_collection
  endunless

  # ---- 更新日（公開から1日以上あとに更新されていれば表示）----
  assign pub_ts = article.published_at | date: '%s' | plus: 0
  assign upd_ts = article.updated_at | date: '%s' | plus: 0
  assign upd_diff = upd_ts | minus: pub_ts
-%}

<div class="c_article__progress" aria-hidden="true"><span class="c_article__progress-bar"></span></div>

<article class="c_article">
  <div class="c_article__inner">
    <div class="c_article__main">
      <header class="c_article__header">
        {%- if category -%}
          <a class="c_article__cat" href="{{ blog.url }}/tagged/{{ category_tag }}">{{ category.name }}</a>
        {%- endif -%}

        <h1 class="c_article__title">{{ article.title | escape }}</h1>

        <div class="c_article__meta">
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">公開日 {{ article.published_at | date: '%Y.%m.%d' }}</time>
          {%- if upd_diff > 86400 -%}
            <time datetime="{{ article.updated_at | date: '%Y-%m-%d' }}">更新日 {{ article.updated_at | date: '%Y.%m.%d' }}</time>
          {%- endif -%}
          <span>執筆：{{ author_name }}</span>
          {%- if supervisor_mo -%}
            <span>監修：{{ supervisor_mo.name }}</span>
          {%- endif -%}
        </div>

        {%- if article.tags.size > 0 -%}
          <div class="c_article__tags">
            {%- for tag in article.tags -%}
              {%- if tag == category_tag %}{% continue %}{% endif -%}
              <a href="{{ blog.url }}/tagged/{{ tag }}">#{% render 'c_tag-label', tag: tag %}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </header>

      {%- if article.image -%}
        <div class="c_article__eyecatch">
          <img
            srcset="
              {{ article.image | image_url: width: 750 }} 750w,
              {{ article.image | image_url: width: 1100 }} 1100w,
              {{ article.image | image_url: width: 1500 }} 1500w
            "
            sizes="(min-width: 750px) 760px, 100vw"
            src="{{ article.image | image_url: width: 1100 }}"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
            alt="{{ article.image.alt | default: article.title | escape }}"
            fetchpriority="high"
          >
        </div>
      {%- endif -%}

      {%- comment -%} スマホ用 折りたたみ目次（中身はJSが生成） {%- endcomment -%}
      <details class="c_article__toc-sp" data-c-toc-wrap open>
        <summary>{{ section.settings.toc_title }}</summary>
        <div data-c-toc></div>
      </details>

      <div class="c_article__content">
        {{ article.content }}
      </div>

      {%- if section.settings.show_share -%}
        <div class="c_article__share">
          <span class="c_article__share-label">この記事をシェアする</span>
          <a href="https://twitter.com/share?url={{ request.origin }}{{ article.url }}&text={{ article.title | url_encode }}" rel="nofollow noopener" target="_blank" aria-label="Xでシェア">
            <img src="{{ 'x-icon.png' | file_url }}" alt="X" width="36" height="36" loading="lazy">
          </a>
          <a href="https://line.me/R/msg/text/?{{ article.title | url_encode }}%0a{{ request.origin }}{{ article.url }}" rel="nofollow noopener" target="_blank" aria-label="LINEでシェア">
            <img src="{{ 'line-icon.png' | file_url }}" alt="LINE" width="36" height="36" loading="lazy">
          </a>
          <button type="button" data-c-copy aria-label="リンクをコピー" title="リンクをコピー">&#128279;</button>
        </div>
      {%- endif -%}

      {%- if author_mo or supervisor_mo or section.settings.default_author != blank -%}
        <div class="c_article__authors">
          {% render 'c_article-author-card', person: author_mo, label: '執筆者', fallback_name: section.settings.default_author %}
          {%- if supervisor_mo -%}
            {% render 'c_article-author-card', person: supervisor_mo, label: '監修者' %}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if cta_collection -%}
        <div class="c_article__cta">
          <p class="c_article__cta-heading">{{ section.settings.cta_heading }}</p>
          <a class="c_article__cta-card" href="{{ cta_collection.url }}">
            {%- if cta_collection.image -%}
              <img src="{{ cta_collection.image | image_url: width: 220 }}" alt="{{ cta_collection.title | escape }}" width="110" height="110" loading="lazy">
            {%- elsif cta_collection.products.first.featured_image -%}
              <img src="{{ cta_collection.products.first.featured_image | image_url: width: 220 }}" alt="{{ cta_collection.title | escape }}" width="110" height="110" loading="lazy">
            {%- endif -%}
            <span>
              <span class="c_article__cta-name">{{ cta_collection.title }}</span>
              {%- if cta_collection.description != blank -%}
                <span class="c_article__cta-text">{{ cta_collection.description | strip_html | truncate: 60 }}</span>
              {%- endif -%}
            </span>
            <span class="c_article__cta-arrow">&rarr;</span>
          </a>
        </div>
      {%- endif -%}

      {%- if category_tag != blank -%}
        {%- assign related_count = 0 -%}
        {%- capture related_html -%}
          {%- for a in blog.articles -%}
            {%- if a.id == article.id %}{% continue %}{% endif -%}
            {%- unless a.tags contains category_tag %}{% continue %}{% endunless -%}
            <a class="c_articleCard" href="{{ a.url }}">
              {%- if a.image -%}
                <img class="c_articleCard__img" src="{{ a.image | image_url: width: 600 }}" alt="{{ a.title | escape }}" width="600" height="375" loading="lazy">
              {%- else -%}
                <span class="c_articleCard__img"></span>
              {%- endif -%}
              <span class="c_articleCard__date">{{ a.published_at | date: '%Y.%m.%d' }}</span>
              <span class="c_articleCard__title">{{ a.title }}</span>
            </a>
            {%- assign related_count = related_count | plus: 1 -%}
            {%- if related_count >= 3 %}{% break %}{% endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if related_count > 0 -%}
          <div class="c_article__related">
            <h2 class="c_article__related-heading">{{ section.settings.related_heading }}</h2>
            <div class="c_article__related-list">{{ related_html }}</div>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- assign all_categories = shop.metaobjects.article_category.values -%}
      {%- if all_categories.size > 0 -%}
        <nav class="c_article__catnav" aria-label="コラムカテゴリ">
          <p class="c_article__catnav-heading">カテゴリから探す</p>
          <ul>
            {%- for cat in all_categories -%}
              <li><a href="{{ blog.url }}/tagged/{{ cat.system.handle }}">{{ cat.name }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- comment -%} PC用 追従目次（中身はJSが生成） {%- endcomment -%}
    <aside class="c_article__side" data-c-toc-wrap>
      <div class="c_article__side-inner">
        <div class="c_article__toc-pc">
          <p class="c_article__toc-title">{{ section.settings.toc_title }}</p>
          <div data-c-toc></div>
        </div>
      </div>
    </aside>
  </div>
</article>

<script>
  (() => {
    const content = document.querySelector('.c_article__content');
    if (!content) return;

    // ---- 目次自動生成 ----
    const headings = content.querySelectorAll('h2, h3');
    const tocTargets = document.querySelectorAll('[data-c-toc]');
    if (headings.length < 2) {
      document.querySelectorAll('[data-c-toc-wrap]').forEach((el) => el.remove());
    } else {
      const list = document.createElement('ol');
      list.className = 'c_articleToc__list';
      headings.forEach((h, i) => {
        const id = 'toc-' + (i + 1);
        h.id = id;
        const li = document.createElement('li');
        li.className = 'c_articleToc__item --' + h.tagName.toLowerCase();
        const a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = h.textContent;
        li.appendChild(a);
        list.appendChild(li);
      });
      tocTargets.forEach((t) => t.appendChild(list.cloneNode(true)));

      // ---- スクロール追従ハイライト ----
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            document.querySelectorAll('[data-c-toc] a').forEach((a) => {
              a.classList.toggle('is-active', a.getAttribute('href') === '#' + entry.target.id);
            });
          });
        },
        { rootMargin: '0px 0px -75% 0px' }
      );
      headings.forEach((h) => observer.observe(h));
    }

    // ---- 読了プログレスバー ----
    const bar = document.querySelector('.c_article__progress-bar');
    if (bar) {
      const onScroll = () => {
        const rect = content.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const passed = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        bar.style.width = (total > 0 ? (passed / total) * 100 : 100) + '%';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // ---- リンクコピー ----
    const copyBtn = document.querySelector('[data-c-copy]');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(location.href).then(() => {
          copyBtn.classList.add('is-copied');
          setTimeout(() => copyBtn.classList.remove('is-copied'), 1500);
        });
      });
    }
  })();
</script>

{%- comment -%} 構造化データ：Article + パンくず {%- endcomment -%}
{%- capture og_image -%}{{ article.image | image_url: width: 1200 }}{%- endcapture -%}
{%- unless og_image contains 'http' -%}{%- assign og_image = 'https:' | append: og_image -%}{%- endunless -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ request.origin | append: article.url | json }} },
    {% if article.image %}"image": [{{ og_image | json }}],{% endif %}
    {% if category %}"articleSection": {{ category.name.value | json }},{% endif %}
    "author": { "@type": "Person", "name": {{ author_name | json }}{% if author_mo.role_title.value %}, "jobTitle": {{ author_mo.role_title.value | json }}{% endif %} },
    {% if supervisor_mo %}"reviewedBy": { "@type": "Person", "name": {{ supervisor_mo.name.value | json }}{% if supervisor_mo.role_title.value %}, "jobTitle": {{ supervisor_mo.role_title.value | json }}{% endif %} },{% endif %}
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | json }} }
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "TOP", "item": {{ request.origin | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} }
      {%- if category -%}
        ,{ "@type": "ListItem", "position": 3, "name": {{ category.name.value | json }}, "item": {{ request.origin | append: blog.url | append: '/tagged/' | append: category_tag | json }} }
        ,{ "@type": "ListItem", "position": 4, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
      {%- else -%}
        ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
      {%- endif -%}
    ]
  }
</script>

{% schema %}
{
  "name": "コラム記事",
  "settings": [
    {
      "type": "text",
      "id": "toc_title",
      "label": "目次の見出し",
      "default": "目次"
    },
    {
      "type": "text",
      "id": "default_author",
      "label": "デフォルトの執筆者名（記事に著者メタフィールド未設定時）",
      "default": "マンマボーノ編集部"
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "シェアボタンを表示",
      "default": true
    },
    {
      "type": "header",
      "content": "商品CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "商品CTAの見出し",
      "default": "この記事を読んだ方におすすめ"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "デフォルトの誘導先コレクション（記事メタフィールド未設定時）"
    },
    {
      "type": "header",
      "content": "関連記事"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "関連記事の見出し",
      "default": "関連記事"
    },
    {
      "type": "header",
      "content": "上下の余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "上部の余白（PC）",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "下部の余白（PC）",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_sp",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上部の余白（SP）",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下部の余白（SP）",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "コラム記事",
      "category": "カスタムパーツ"
    }
  ]
}
{% endschema %}
