{{ 'c_common.min.css' | asset_url | stylesheet_tag }}
{{ 'c_topFv.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_sp }}px;
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

{%- assign fv_banners = section.blocks | where: 'type', 'banner' -%}

<div class="c_topFv{% if fv_banners.size > 0 %} --has-banner{% endif %}">
  <img class="pc" src="{{ 'fv.webp' | file_url }}" alt="犬と猫の画像" width="1397">
  <img class="sp" src="{{ 'fv_sp.webp' | file_url }}" alt="犬と猫の画像" width="354">
  <h1 class="c_topFv-title">
    <span>{{ section.settings.title1 }}</span><br>
    <span>{{ section.settings.title2 }}</span>
  </h1>
  {%- if fv_banners.size > 0 -%}
    <div class="c_topFv__banner">
      <div class="swiper --fvBanner">
        <div class="swiper-wrapper">
          {%- for block in fv_banners -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.banner-link }}"{% if block.settings.banner-new-tab %} target="_blank" rel="noopener"{% endif %}>
                {{
                  block.settings['banner-img']
                  | image_url: width: 480, height: 480
                  | image_tag: alt: block.settings['banner-img'].alt, loading: 'eager'
                }}
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if fv_banners.size > 1 -%}
        <div class="swiper-pagination --fvBanner"></div>
      {%- endif -%}
    </div>
  {%- endif -%}
{% comment %}   <a class="c_topFv__about-link" href="/pages/about">
    <img src="{{ 'about-link.png' | file_url }}" alt="マンマボーノとは" width="109">
  </a> {% endcomment %}
</div>

{% schema %}
{
  "name": "ファーストビュー",
  "settings": [
    {
      "type": "text",
      "id": "title1",
      "label": "見出し1",
      "default": "見出し1"
    },
    {
      "type": "text",
      "id": "title2",
      "label": "見出し2",
      "default": "見出し2"
    },
    {
      "type": "header",
      "content": "上下の余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "上部の余白（pc）",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "下部の余白（PC)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_sp",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "上部の余白",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "下部の余白",
      "default": 32
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "banner",
      "name": "FV内バナー（右下）",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner-img",
          "label": "バナー画像（正方形）",
          "info": "PCは一辺がFV高さの38%（約200px）で表示されます。文字は3〜5語程度に絞ってください。"
        },
        {
          "type": "url",
          "id": "banner-link",
          "label": "バナーのリンク先"
        },
        {
          "type": "checkbox",
          "id": "banner-new-tab",
          "label": "別タブで開く",
          "default": true
        }
      ]
    }
  ],
  "presets":[
    {
      "name" : "ファーストビュー",
      "category": "カスタムパーツ"
    }
  ]
}
{% endschema %}