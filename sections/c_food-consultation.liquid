{% comment %}Dedicated service page. Assign product.consultation only to food-consultation.{% endcomment %}
{% if product.handle == 'food-consultation' %}
  {{ 'c_common.min.css' | asset_url | stylesheet_tag }}
  {{ 'c_under.min.css' | asset_url | stylesheet_tag }}
  <div class="c_underFv-wrap food-consultation-fv">
    <div class="c_underFv">
      <div class="c_underFv__img">
        <img src="{{ 'consultation-cover-dogcat.jpg' | asset_url }}" width="1907" height="1280" alt="ごはんの器を前に、キッチンで並ぶ犬と猫" fetchpriority="high">
        <div class="c_underFv__text">
          <h1 class="c_underFv__title--en">CONSULTATION</h1>
          <h2 class="c_underFv__title--jp">フードのご相談</h2>
        </div>
      </div>
    </div>
  </div>
  {% assign consultation_variant = product.selected_or_first_available_variant %}
  {% assign consultation_intro = product.description | split: '</p>' | first | append: '</p>' %}
  {% assign consultation_details = product.description | remove_first: consultation_intro %}
  {% assign consultation_details = consultation_details | replace: 'ご購入後、西川からご登録のメールアドレスへ、ご相談の日時のご案内をお送りします。', 'ご購入後、担当者からご登録のメールアドレスへ、ご相談の日時のご案内をお送りします。' | replace: '日時が決まりましたら、メールまたはオンラインでご相談をお受けし、回答いたします。', '日時が決まりましたらZoom URLをお送りいたしますので、Zoomにてご相談をお受けし、回答いたします。' %}
  <section class="food-consultation page-width" aria-labelledby="ConsultationTitle-{{ section.id }}">
    <div class="food-consultation__hero">
      <div class="food-consultation__intro">
        <h2 id="ConsultationTitle-{{ section.id }}" class="food-consultation__title">{{ product.title | escape }}</h2>
      </div>
        <div class="food-consultation__booking">
          <p class="food-consultation__price">ご相談料 <strong>{{ consultation_variant.price | money }}</strong>{% if cart.taxes_included %}<small>（税込）</small>{% endif %}</p>
          {% if consultation_variant.available %}
            <a href="{{ routes.cart_url }}/{{ consultation_variant.id }}:1" class="food-consultation__submit">相談を依頼する</a>
          {% else %}
            <button type="button" class="food-consultation__submit" disabled>ただいま受付を停止しています</button>
          {% endif %}

        </div>
        <div class="food-consultation__description rte">{{ consultation_intro }}</div>
        <p class="food-consultation__note">次のチェックアウト画面で、お申し込み内容とお支払い方法をご確認ください。<br>お申し込み後、ご登録のメールアドレスへ日程をご案内します。</p>
    </div>
    <div class="food-consultation__details rte">
      {{ consultation_details }}
    </div>
  </section>
  <script type="application/ld+json">{{ product | structured_data }}</script>
{% endif %}

{% style %}
  .food-consultation-fv .c_underFv__img img { object-position: 50% 65%; }
  @media screen and (max-width: 749px) {
    .food-consultation-fv { padding-top: 10px; }
    .food-consultation-fv .c_underFv__img img { object-position: 50% 65%; }
  }
  .food-consultation { padding-top: 44px; padding-bottom: 80px; color: #3c3c3c; font-family: var(--font-body-family); }
  .food-consultation__hero { display: flex; flex-direction: column; align-items: center; padding: 40px; border: 1px solid #c5c5c5; text-align: center; }
  .food-consultation__intro { min-width: 0; }
  .food-consultation__title { color: #3c3c3c; font-family: var(--font-body-family); font-size: 22px; font-weight: 700; line-height: 1.6; letter-spacing: .88px; text-align: center; white-space: normal; margin: 0 0 20px; }
  .food-consultation p { font-size: 16px; line-height: 1.7; letter-spacing: .64px; }
  .food-consultation__booking { width: 100%; max-width: 334px; }
  .food-consultation__description { max-width: 760px; margin-top: 28px; }
  .food-consultation__price { margin: 0 0 20px; }
  .food-consultation__price strong { font-size: 24px; font-weight: 400; margin-left: 12px; letter-spacing: .96px; }
  .food-consultation__price small { font-size: 13px; }
  .food-consultation__submit { display: flex; align-items: center; justify-content: center; box-sizing: border-box; text-decoration: none; width: 100%; height: 68px; min-height: 68px; padding: 16px; border: 1px solid #ff7b5e; border-radius: 70px; background: #ff7b5e; color: #fff; font-family: var(--font-body-family); font-size: 16px; font-weight: 700; line-height: 1.491; letter-spacing: .56px; cursor: pointer; transition: background-color .3s, color .3s; }
  .food-consultation__submit:hover { background: #fff; color: #ff7b5e; }
  .food-consultation__submit:focus-visible { outline: 2px solid #3c3c3c; outline-offset: 4px; }
  .food-consultation__submit:disabled { opacity: .55; cursor: not-allowed; }
  .food-consultation p.food-consultation__note { font-size: 13px; line-height: 1.7; margin: 16px 0 0; }
  .food-consultation__details { margin-top: 48px; font-size: 16px; line-height: 1.7; letter-spacing: .64px; }
  .food-consultation__details h2 { color: #ff7b5e; font-family: var(--font-body-family); font-size: 24px; font-weight: 700; line-height: 1.6; margin: 40px 0 20px; padding-bottom: 16px; border-bottom: 1px solid #c5c5c5; }
  .food-consultation__details li { margin-bottom: 12px; }
  @media screen and (max-width: 749px) {
    body:has(.food-consultation) .c_underFv__title--en { font-size: 32px; letter-spacing: 2.56px; }
    .food-consultation { padding-top: 32px; padding-bottom: 60px; }
    .food-consultation__hero { padding: 28px 20px; }
    .food-consultation__description,
    .food-consultation p.food-consultation__note { width: 100%; text-align: left; }
    .food-consultation__booking { width: 100%; max-width: 400px; margin: auto; }
    .food-consultation__details { margin-top: 36px; }
    .food-consultation__details h2 { font-size: 22px; }
  }
{% endstyle %}

{% schema %}
{ "name": "フードのご相談", "settings": [] }
{% endschema %}
